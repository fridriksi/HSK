{
  "name": "hsk-vefur",
  "private": true,
  "type": "module",
  "scripts": {
    "vendor": "node scripts/copy-vendor.mjs",
    "db:migrate": "wrangler d1 migrations apply hsk --local",
    "db:seed": "wrangler d1 execute hsk --local --file=seed/seed.sql && node scripts/seed-media.mjs",
    "setup": "npm run vendor && npm run db:migrate && npm run db:seed",
    "dev": "npm run vendor && wrangler dev",
    "check": "tsc --noEmit",
    "test": "node scripts/smoke-test.mjs",
    "deploy": "npm run vendor && wrangler deploy"
  },
  "dependencies": {
    "hono": "^4.13.23",
    "tinymce": "^6.8.5",
    "xss": "^1.0.17"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261127.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.169.0"
  }
}
